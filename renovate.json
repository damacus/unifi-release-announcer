{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>damacus/renovate-config",
    "local>damacus/renovate-config:autoMergeGitHubActions.json5"
  ],
  "packageRules": [
    {
      "description": "Auto-merge documentation tooling updates",
      "matchFileNames": [
        "pyproject.toml",
        "uv.lock"
      ],
      "matchPackageNames": [
        "mkdocs",
        "mkdocs-material"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Maintain Cargo dependencies and lockfile",
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Require passing CI and 24-hour release age for minor auto-merge",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "24 hours",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "platformAutomerge": false,
      "ignoreTests": false
    },
    {
      "description": "Keep major upgrades and unaged update types manual",
      "matchUpdateTypes": [
        "major",
        "digest",
        "pin",
        "pinDigest",
        "lockFileMaintenance",
        "rollback",
        "replacement"
      ],
      "automerge": false
    }
  ],
  "minimumReleaseAge": "24 hours",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "ignoreTests": false
}
